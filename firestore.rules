rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All writes in this app happen after portal login -> Firebase custom
    // token -> signInWithCustomToken() (see api/session.js), so every
    // legitimate client request already carries request.auth. The public
    // share page (/share/:shareCode) never touches Firestore directly --
    // it reads via api/get-rams-share.js using the Admin SDK server-side,
    // which bypasses these rules entirely, so requiring auth here has no
    // effect on it.
    //
    // Previously `if true` -- anyone who inspected the public Firebase
    // client config (visible by design in the JS bundle) could read,
    // write, or delete any document directly, bypassing portal login
    // entirely.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
